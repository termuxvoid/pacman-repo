# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/weeman)

pkgname="weeman"
pkgver=1.7.1
pkgrel=1
pkgdesc='HTTP server for phishing in python2'
arch=('any')
url="https://github.com/evait-security/weeman"
depends=('python2' 'git')
install="weeman.install"
options=('!strip' '!debug' '!emptydirs')
source=(weeman-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/weeman-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
