#!/bin/bash

pre_install() {
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  return 1
else
  echo "Preparing enviroment ..."
  if [[ -d ${HOME}/.local/share/weeman ]]
  then
    rm -rf ${HOME}/.local/share/weeman
  else
    mkdir -p ${HOME}/.local/share 2>/dev/null
  fi
fi
}

post_install() {
bash ${PREFIX}/bin/weeman-installer
echo "[*] weeman installation finished."
echo "[*] Run \'weeman\' to execute it."
}

pre_remove() {
if [[ -d ${HOME}/.local/share/weeman ]]; then
  rm -rf ${HOME}/.local/share/weeman
fi
}

post_remove() {
echo "Done. Package 'weeman' removed."
}

