#!/bin/bash

pre_install() {
venomDir="$PREFIX/var/venom"

if [[ $(id -u) -eq 0 ]]
then
	echo -en "\e[31m(_➤)\e[0m You need to be a common user"
  return 1
else
	echo "Preparing enviroment ..."
	if [[ -d $venomDir ]]
	then
		rm -rf $venomDir
	fi
fi
}

post_install() {
venomDir="$PREFIX/var/venom"
git clone --quiet https://github.com/Anon4You/Venom $venomDir

[[ -d $venomDir ]] && {
  echo "Installing requirements ..."
  chmod 751 -R $venomDir
  npm -g install tunnelmole
} || {
 echo -en "\e[31mE:\e[0m Venom directory missing ... \e[33mAborting.\e[0m\n"
}
return 0
}

pre_remove() {
venomDir="$PREFIX/var/venom"
if [[ -d "$venomDir" ]]; then
  rm -rf $venomDir
fi
}

post_remove() {
echo "[*] venom removed.."
return 0
}

