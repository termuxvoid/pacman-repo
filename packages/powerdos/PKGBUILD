# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/powerdos)

pkgname="powerdos"
pkgver=1.0.1
pkgrel=1
pkgdesc='A multi-threaded Denial of Service tool made in Python'
arch=('any')
depends=('python')
options=('!strip' '!debug' '!emptydirs')
source=(powerdos-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/powerdos-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
