# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/cupp)

pkgname="cupp"
pkgver=3.3.0
pkgrel=1
pkgdesc='Common User Passwords Profiler (CUPP)'
arch=('any')
url="https://github.com/Mebus/cupp"
depends=('termux-exec' 'python')
options=('!strip' '!debug' '!emptydirs')
source=(cupp-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/cupp-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
