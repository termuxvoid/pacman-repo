#!/bin/bash

post_install() {
set -e

REPO="https://github.com/aircrack-ng/aircrack-ng.git"
TMP_DIR="$TMPDIR/aircrack-ng-build"

git clone --depth 1 "$REPO" "$TMP_DIR"
cd "$TMP_DIR"

NOCONFIGURE=1 ./autogen.sh
./configure --prefix="$PREFIX" --with-experimental
make -j$(nproc)
make install

# Install airmon-ng separately
install -Dm700 -t "$PREFIX/bin" scripts/airmon-ng

cd /
rm -rf "$TMP_DIR"

echo "aircrack-ng 1.7 installed successfully."
echo ""
echo "Usage examples:"
echo "  airmon-ng start wlan0    # Enable monitor mode"
echo "  airodump-ng wlan0mon     # Capture packets"
echo "  aircrack-ng capture.cap  # Crack WEP/WPA"
echo "  aireplay-ng -0 5 -a AP_MAC -c CLIENT_MAC wlan0mon  # Deauth attack"
echo ""
echo "NOTE: Requires root privileges. Run with sudo."
return 0
}

post_remove() {

# Remove all binaries from bin/
for bin in aircrack-ng airdecap-ng packetforge-ng ivstools kstats makeivs-ng airdecloak-ng besside-ng-crawler wpaclean airolib-ng buddy-ng airmon-ng airbase-ng aireplay-ng airodump-ng airserv-ng airtun-ng airventriloquist-ng besside-ng easside-ng tkiptun-ng wesside-ng; do
    rm -f "$PREFIX/bin/$bin"
done

# Remove libraries
rm -f "$PREFIX/lib/libaircrack-"*.so*
rm -f "$PREFIX/lib/libaircrack-"*.la

# Remove headers
rm -rf "$PREFIX/include/aircrack-ng"

# Clean up any leftover sbin directory
rm -rf "$PREFIX/sbin" 2>/dev/null || true

echo "aircrack-ng completely removed."
return 0
}

