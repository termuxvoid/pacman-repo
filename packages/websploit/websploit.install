#!/bin/bash

pre_install() {
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  return 1
else
  echo "Preparing enviroment ..."
  if [[ -d ${HOME}/.local/share/websploit ]]
  then
    rm -rf ${HOME}/.local/share/websploit
  else
    mkdir -p ${HOME}/.local/share 2>/dev/null
  fi
fi
}

post_install() {
bash ${PREFIX}/bin/websploit-installer
rm -rf ${PREFIX}/bin/websploit-installer
echo "[*] websploit installation finished."
echo "[*] Run 'websploit' to execute it."
}

pre_remove() {
if [[ -d ${HOME}/.local/share/websploit ]]; then
  rm -rf ${HOME}/.local/share/websploit
fi
}

post_remove() {

}

