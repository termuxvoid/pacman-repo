# Ported from TermuxVoid APT repo (packages/maskme)

pkgname="maskme"
pkgver=1.0.0
pkgrel=1
pkgdesc='Give a Mask to Phishing URL like a PRO'
arch=('any')
options=('!strip' '!debug' '!emptydirs')
source=(maskme-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/maskme-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
