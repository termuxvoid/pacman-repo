# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/termuxfetch)

pkgname="termuxfetch"
pkgver=2.0
pkgrel=1
pkgdesc='Neofetch‑like system information tool for Termux'
arch=('any')
depends=('bash')
options=('!strip' '!debug' '!emptydirs')
source=(termuxfetch-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/termuxfetch-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
