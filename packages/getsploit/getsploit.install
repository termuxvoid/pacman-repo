#!/bin/bash

post_install() {
set -e

export ANDROID_API_LEVEL=$(getprop ro.build.version.sdk)

# Install getsploit and vulners without dependencies (avoid isal build issues)
pip install getsploit==3.0.1 --no-deps
pip install vulners --no-deps

# Install remaining dependencies manually
# TUR community wheel index + prefer-binary: prebuilt Android wheels
# (brotli, pydantic-core) instead of slow on-device source builds.
pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary \
    h2 hpack hyperframe ijson httpx pydantic pydantic-core click rich \
    brotli zstandard pycryptodome stream-inflate stream-unzip orjson

echo "getsploit installed. Run 'getsploit'"
return 0
}

post_remove() {

# Uninstall the manually installed packages (optional, but cleans up)
pip uninstall -y getsploit vulners h2 hpack hyperframe ijson httpx \
    pydantic pydantic-core click rich brotli zstandard pycryptodome \
    stream-inflate stream-unzip orjson 2>/dev/null || true

echo "getsploit removed."
return 0
}

