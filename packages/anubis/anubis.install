#!/bin/bash

post_install() {
set -e

pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary anubis-netsec==1.4.0

echo "anubis installed. Run 'anubis'"
return 0
}

post_remove() {

pip uninstall -y anubis-netsec 2>/dev/null || true

echo "anubis removed."
return 0
}

