#!/bin/bash

post_install() {
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}

VERSION="1.3.1"
BUILD_DIR="$TMPDIR/dnsx-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/dnsx/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o dnsx ./cmd/dnsx
install -Dm755 dnsx "$PREFIX/bin/dnsx"

cd / && rm -rf "$BUILD_DIR"

echo "dnsx installed. Run 'dnsx'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/dnsx"
echo "dnsx removed."
return 0
}
