# Ported from TermuxVoid APT repo (packages/infect)

pkgname="infect"
pkgver=1.03
pkgrel=1
pkgdesc='Android APK backdoor injector with Meterpreter support'
arch=('any')
url="https://telegram.me/nullxvoid/"
depends=('apkeditor' 'apktool' 'metasploit-framework' 'apksigner' 'libxml2')
options=('!strip' '!debug' '!emptydirs')
source=(infect-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/infect-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
