#!/bin/bash

post_install() {
set -e

VERSION="2.7.2"
BUILD_DIR="$TMPDIR/brutespray-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/x90skysn3k/brutespray/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="551f8a4fe270a86cae63cc78a1cc4a79d0939b84710b1d507fcb7a4fa06b8b8a"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    return 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o ./dist/brutespray .
install -Dm755 ./dist/brutespray "$PREFIX/bin/brutespray"

cd / && rm -rf "$BUILD_DIR"

echo "brutespray installed. Run 'brutespray'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/brutespray"
echo "brutespray removed."
return 0
}

