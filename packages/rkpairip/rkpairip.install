#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing rkpairip...${NC}"

echo -e "${YELLOW}Installing pairip via pip...${NC}"
pip install Pairip==5.3 || {
    echo -e "${RED}Error: Failed to install pairip.${NC}"
    return 1
}

echo -e "${GREEN}rkpairip installed successfully!${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling rkpairip...${NC}"

pip uninstall -y pairip 2>/dev/null || {
    echo -e "${YELLOW}pairip not found or already uninstalled.${NC}"
}

echo -e "${GREEN}rkpairip completely removed${NC}"
return 0
}

