# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/blackhat)

pkgname="blackhat"
pkgver=1.0
pkgrel=1
pkgdesc='blackhat hacking sources'
arch=('any')
options=('!strip' '!debug' '!emptydirs')
source=(blackhat-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/blackhat-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
