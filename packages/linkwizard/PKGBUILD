# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/linkwizard)

pkgname="linkwizard"
pkgver=1.0
pkgrel=1
pkgdesc='Powerful profile link finder for Termux'
arch=('any')
url="https://telegram.me/nullxvoid"
depends=('python' 'python-pip')
install="linkwizard.install"
options=('!strip' '!debug' '!emptydirs')
source=(linkwizard-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/linkwizard-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
