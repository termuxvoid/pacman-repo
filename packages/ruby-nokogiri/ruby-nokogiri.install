#!/bin/bash

post_install() {
set -e

    # nokogiri native ext must link system libs, never bundled C sources
    # (mirrors the rule in CONTRIBUTING.md / wpscan.install / ruby-ethon.install)
    export NOKOGIRI_USE_SYSTEM_LIBRARIES=1

    # pacman passes "$1" as pkgver-pkgrel; upstream pins need bare pkgver
    UPVER="${1%%-*}"

    echo "Installing Nokogiri ${UPVER} with system libraries..."

    # Fetch the nokogiri gumbo parser header at install time instead of shipping
    # it in the package data (matches upstream source, keeps the package small).
    mkdir -p "$PREFIX/include"
    if [ ! -f "$PREFIX/include/nokogiri_gumbo.h" ]; then
        wget -q "https://raw.githubusercontent.com/sparklemotion/nokogiri/v${UPVER}/gumbo-parser/src/nokogiri_gumbo.h" \
            -O "$PREFIX/include/nokogiri_gumbo.h" \
            || curl -fsSL "https://raw.githubusercontent.com/sparklemotion/nokogiri/v${UPVER}/gumbo-parser/src/nokogiri_gumbo.h" \
            -o "$PREFIX/include/nokogiri_gumbo.h"
    fi

    gem install nokogiri -v "${UPVER}" -- --use-system-libraries

    # Ruby 4.x no longer auto-loads rubygems, so plain `ruby -rnokogiri` (and
    # any gem require) fails with LoadError. Ship nokogiri into site_ruby (repo
    # convention, cf. ruby-curb) and make it require rubygems itself so it works
    # with or without rubygems preloaded (covers `nokogiri`, `bundler`, scripts).
    GEM_DIR="$(find "$PREFIX/lib/ruby/gems" -maxdepth 4 -type d -name "nokogiri-${UPVER}" | head -n1)"
    SITE_RUBY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitelibdir"]')"

    mkdir -p "$SITE_RUBY"
    cp -r "$GEM_DIR/lib/nokogiri" "$SITE_RUBY/"
    cp -r "$GEM_DIR/lib/xsd" "$SITE_RUBY/"
    cp "$GEM_DIR/lib/nokogiri.rb" "$SITE_RUBY/"

    for f in "$SITE_RUBY/nokogiri.rb" "$SITE_RUBY/nokogiri/version/info.rb" "$SITE_RUBY/nokogiri/extension.rb"; do
        [ -f "$f" ] || continue
        grep -q 'require "rubygems" unless defined?(Gem)' "$f" ||
            sed -i '1i require "rubygems" unless defined?(Gem)' "$f"
    done

    echo "Verifying installation..."
    ruby -rnokogiri -e "puts Nokogiri::VERSION" || {
        echo "Nokogiri installation failed!" >&2
        return 1
    }

    echo "Nokogiri ${UPVER} installed successfully."
    return 0
}

post_remove() {
# Post-removal script for ruby-nokogiri

set -e

echo "Removing Nokogiri gem..."
gem uninstall nokogiri -v 1.19.4 -x || true

# Also try to remove any other versions that might be installed
gem uninstall nokogiri -a -x -I || true

echo "Cleaning up residual files..."
[ -d "$PREFIX/lib/ruby/gems" ] && find "$PREFIX/lib/ruby/gems" -name "*nokogiri*" -exec rm -rf {} + || true

# Remove the site_ruby copies installed by post_install (ruby 4.x paths)
for d in "$PREFIX"/lib/ruby/site_ruby/*/; do
    rm -rf "$d/nokogiri"
    rm -f  "$d/nokogiri.rb"
    rm -rf "$d/xsd"
done

# Remove nokogiri binary from bin directory if it exists
if [ -f "$PREFIX/bin/nokogiri" ]; then
    echo "Removing nokogiri binary from $PREFIX/bin..."
    rm -f "$PREFIX/bin/nokogiri"
fi

# Remove the gumbo parser header fetched at install time
rm -f "$PREFIX/include/nokogiri_gumbo.h"

echo "Nokogiri removal complete."
return 0
}