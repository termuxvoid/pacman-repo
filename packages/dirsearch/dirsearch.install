#!/bin/bash

post_install() {
set -e

export ANDROID_API_LEVEL=$(getprop ro.build.version.sdk)

REPO="https://github.com/maurosoria/dirsearch.git"
TMP_DIR="$TMPDIR/dirsearch-build"

rm -rf "$TMP_DIR" 2>/dev/null || true

git clone --depth 1 -q "$REPO" "$TMP_DIR"
cd "$TMP_DIR"
pip install .

cd /
rm -rf "$TMP_DIR"

echo "dirsearch installed. Run 'dirsearch'"
return 0
}

post_remove() {

pip3 uninstall -y dirsearch 2>/dev/null || true

echo "dirsearch removed."
return 0
}

