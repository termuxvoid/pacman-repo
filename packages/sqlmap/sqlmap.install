#!/bin/bash

post_install() {
    set -e

    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m'

    pip install "sqlmap==${1}" || {
        echo -e "${RED}Error: Failed to install sqlmap.${NC}"
        echo -e "${YELLOW}Make sure dependencies (python, python-pip) are installed.${NC}"
        return 1
    }

    echo -e "${GREEN}sqlmap ${1} installed successfully!${NC}"
    echo -e "${YELLOW}Usage examples:${NC}"
    echo "  sqlmap -u http://example.com/vuln.php?id=1"
    echo "  sqlmap -l targets.txt"
    echo "  sqlmap -r request.txt"
    echo "  sqlmap -h    # Basic help"
}

pre_remove() {
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m'

    echo -e "${GREEN}Uninstalling sqlmap...${NC}"
    pip uninstall -y sqlmap 2>/dev/null || {
        echo -e "${YELLOW}sqlmap not found or already uninstalled.${NC}"
    }
}
