# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/androdos)

pkgname="androdos"
pkgver=1.0.0
pkgrel=1
pkgdesc='Denials of service(DoS) attack tool '
arch=('any')
depends=('python')
options=('!strip' '!debug' '!emptydirs')
source=(androdos-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/androdos-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
