#!/bin/bash

pre_install() {
ARCH=$(uname -m)
case "$ARCH" in
    aarch64|x86_64)
        return 0
        ;;
    *)
        echo "Error: statusbar only supports aarch64 or x86_64." >&2
        echo "Your architecture: $ARCH" >&2
        return 1
        ;;
esac
}

post_install() {
set -e

VERSION="0.5.1"
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
SHARE_DIR="$PREFIX/share/statusbar"
TMP_DIR="$TMPDIR/statusbar-build"

case "$(uname -m)" in
    aarch64) TARGET="aarch64-linux-musl" ;;
    x86_64)  TARGET="x86_64-linux-musl" ;;
esac

TARBALL="https://github.com/vrypan/statusbar/releases/download/v${VERSION}/statusbar-${VERSION}-${TARGET}.tar.gz"

rm -rf "$TMP_DIR" "$SHARE_DIR"
mkdir -p "$TMP_DIR" "$SHARE_DIR/themes"

curl -fsSL -o "$TMP_DIR/statusbar.tar.gz" "$TARBALL" || {
    echo "Error: Failed to download statusbar." >&2
    return 1
}
tar -xzf "$TMP_DIR/statusbar.tar.gz" -C "$TMP_DIR"

SRC="$TMP_DIR/statusbar-${VERSION}-${TARGET}"

for tool in statusbar statusbar-theme; do
    install -Dm755 "$SRC/bin/$tool" "$PREFIX/bin/$tool"
done

cp "$SRC"/themes/*.statusbar "$SHARE_DIR/themes/"
cp "$SRC/AGENT_SETUP.md" "$SHARE_DIR/AGENT_SETUP.md"

cd / && rm -rf "$TMP_DIR"

echo "statusbar installed. Run 'statusbar' to start your shell with a status bar."
echo "Inside a session, run 'statusbar-theme $SHARE_DIR/themes' to pick a theme."
return 0
}

post_remove() {
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}

rm -f "$PREFIX/bin/statusbar" "$PREFIX/bin/statusbar-theme"
rm -rf "$PREFIX/share/statusbar"

return 0
}
