# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/term-helper)

pkgname="term-helper"
pkgver=1.1.1
pkgrel=1
pkgdesc='Terminal command helper and cheatsheet tool'
arch=('any')
url="https://github.com/Anon4You/term-helper"
depends=('curl' 'pv')
install="term-helper.install"
options=('!strip' '!debug' '!emptydirs')
source=(term-helper-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/term-helper-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
