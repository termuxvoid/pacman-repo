#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Installing SEToolkit via NetHunter...${NC}"
nh apt update -y && nh apt install set -y || {
    echo -e "${RED}Error: Failed to install SEToolkit. Ensure NetHunter CLI is properly configured.${NC}"
    return 1
}

echo -e "${GREEN}Creating launcher at $PREFIX/bin/setoolkit...${NC}"
cat > "$PREFIX/bin/setoolkit" <<- EOF
nh setoolkit "\$@"
EOF

chmod +x "$PREFIX/bin/setoolkit" || {
    echo -e "${RED}Error: Failed to set executable permissions for setoolkit launcher.${NC}"
    return 1
}

echo -e "${GREEN}SEToolkit installed successfully. Run 'setoolkit' to start.${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling SEToolkit...${NC}"

if [ -f "$PREFIX/bin/setoolkit" ]; then
    rm -f "$PREFIX/bin/setoolkit" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

# Removal hooks run without a TTY, so an interactive `read` would hang.
# Default to NOT removing from NetHunter (non-destructive); opt in with
# SETOOLKIT_CLEAN=1 for scripted removals.
choice="${SETOOLKIT_CLEAN:-N}"
[[ "$choice" =~ [yY] ]] && {
    nh apt remove set -y && \
    echo -e "${GREEN}✓ SEToolkit removed from NetHunter${NC}" || \
    echo -e "${RED}✗ Failed to remove from NetHunter${NC}"
}

echo -e "${GREEN}Uninstallation complete${NC}"
return 0
}

