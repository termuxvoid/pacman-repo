#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing ffmpegp 1.30...${NC}"

echo -e "${YELLOW}Installing ffmpegp via pip...${NC}"
pip install ffmpegp==1.30 || {
    echo -e "${RED}Error: Failed to install ffmpegp.${NC}"
    return 1
}

echo -e "${GREEN}ffmpegp installed successfully!${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling ffmpegp...${NC}"

pip uninstall -y ffmpegp 2>/dev/null || {
    echo -e "${YELLOW}ffmpegp not found or already uninstalled.${NC}"
}

echo -e "${GREEN}ffmpegp completely removed${NC}"
return 0
}

