# Ported from TermuxVoid APT repo (packages/phoneinfo)

pkgname="phoneinfo"
pkgver=1.0.1
pkgrel=0
pkgdesc='Phone number lookup tool for termux'
arch=('any')
depends=('termux-tools' 'termux-exec' 'figlet' 'jq')
options=('!strip')
source=(phoneinfo-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    tar -xzf "${srcdir}/phoneinfo-data.tar.gz" -C "${pkgdir}"
}
