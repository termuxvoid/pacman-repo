#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

VERSION="2.2.0"
SHA256="994680999cdc587262e773ba8a2364cc0c82fae63f594b67aab71ae9f42ffe8b"
URL="https://github.com/Anon4You/InstaGhost/archive/refs/tags/v${VERSION}.tar.gz"
BUILD_DIR="${TMPDIR:-$PREFIX/tmp}/instaghost-build"
TARBALL="$BUILD_DIR/instaghost.tar.gz"

echo -e "${GREEN}Installing InstaGhost ${VERSION}...${NC}"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"

# instagrapi needs the community wheel index on Termux
python -m pip install -U pip setuptools wheel || {
    echo -e "${RED}Error: Failed to install Python packaging tools.${NC}"
    return 1
}

python -m pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary instagrapi || {
    echo -e "${RED}Error: Failed to install instagrapi.${NC}"
    return 1
}

echo "Downloading InstaGhost ${VERSION}..."
curl -fsSL -o "$TARBALL" "$URL" || {
    echo -e "${RED}Error: Failed to download InstaGhost ${VERSION}.${NC}"
    rm -rf "$BUILD_DIR"
    return 1
}

if ! printf '%s  %s\n' "$SHA256" "$TARBALL" | sha256sum -c - >/dev/null; then
    echo -e "${RED}Error: Checksum mismatch for InstaGhost ${VERSION}.${NC}"
    rm -rf "$BUILD_DIR"
    return 1
fi

python -m pip install --upgrade --force-reinstall --no-deps --no-build-isolation "$TARBALL" || {
    echo -e "${RED}Error: Failed to install InstaGhost.${NC}"
    rm -rf "$BUILD_DIR"
    return 1
}

rm -rf "$BUILD_DIR"

for cmd in instaghost instaghost-web instaghost-bot; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo -e "${RED}Error: $cmd was not installed.${NC}"
        return 1
    fi
done

echo -e "${GREEN}InstaGhost ${VERSION} installed successfully!${NC}"
echo -e "${YELLOW}Getting started:${NC}"
echo "  instaghost --login --login-user USER --login-pass PASS"
echo "  instaghost TARGET_USERNAME"
echo "  instaghost TARGET_USERNAME -P 10     # Download 10 posts"
echo "  instaghost-web                       # Local web gateway"
echo "  instaghost-bot                       # Telegram bot"
echo "  instaghost --help                    # Show all options"
return 0
}

post_remove() {

GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Removing InstaGhost...${NC}"

python -m pip uninstall -y instaghost >/dev/null 2>&1 || true
rm -f "$PREFIX/bin/instaghost" "$PREFIX/bin/instaghost-web" "$PREFIX/bin/instaghost-bot"

echo -e "${GREEN}InstaGhost removed. Saved sessions and downloads were kept.${NC}"
return 0
}
