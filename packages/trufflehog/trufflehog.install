#!/bin/bash

post_install() {
set -e

VERSION="v3.99.7"
BUILD_DIR="$TMPDIR/trufflehog-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/trufflesecurity/trufflehog/archive/refs/tags/v3.99.7.tar.gz"
SHA256="f284d50caa6e32e6625e396363bdf7946eb10b9311171f0db1fe2e0e83ace1de"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    return 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o trufflehog .
install -Dm755 trufflehog "$PREFIX/bin/trufflehog"

cd / && rm -rf "$BUILD_DIR"

echo "trufflehog installed. Run 'trufflehog'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/trufflehog"
echo "trufflehog removed."
return 0
}

