#!/bin/bash

post_install() {
set -e

REPO="https://github.com/ffuf/ffuf.git"
TAG="v2.2.1"
TMP_DIR="$TMPDIR/ffuf-build"
BIN_DIR="$PREFIX/bin"

rm -rf "$TMP_DIR" 2>/dev/null || true

git clone --depth 1 --branch "$TAG" -q "$REPO" "$TMP_DIR"
cd "$TMP_DIR"

go build -trimpath -ldflags "-w -s" -o ffuf

install -Dm755 ffuf "$BIN_DIR/ffuf"

cd /
rm -rf "$TMP_DIR"

echo "ffuf installed. Run 'ffuf'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/ffuf"
echo "ffuf removed."
return 0
}

