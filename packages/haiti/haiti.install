#!/bin/bash

post_install() {
set -e

    # nokogiri native ext must link system libs, never bundled C sources
    export NOKOGIRI_USE_SYSTEM_LIBRARIES=1

gem install haiti-hash -v 4.0.0 -- --use-system-libraries

echo "haiti installed. Run 'haiti'"
return 0
}

post_remove() {

gem uninstall haiti-hash -v 4.0.0 -x --force 2>/dev/null || true

echo "haiti removed."
return 0
}

