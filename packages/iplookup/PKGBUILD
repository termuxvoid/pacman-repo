# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/iplookup)

pkgname="iplookup"
pkgver=1.0.0
pkgrel=1
pkgdesc='Ip address info gethering script..'
arch=('any')
depends=('termux-exec' 'termux-tools' 'figlet' 'toilet' 'pv')
options=('!strip' '!debug' '!emptydirs')
source=(iplookup-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/iplookup-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
