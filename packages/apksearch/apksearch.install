#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing apksearch 1.3.5...${NC}"

echo -e "${YELLOW}Installing apksearch via pip...${NC}"
pip install -U apksearch || {
    echo -e "${RED}Error: Failed to install apksearch.${NC}"
    return 1
}

echo -e "${GREEN}apksearch installed successfully!${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling apksearch...${NC}"

pip uninstall -y apksearch 2>/dev/null || {
    echo -e "${YELLOW}apksearch not found or already uninstalled.${NC}"
}

echo -e "${GREEN}apksearch completely removed${NC}"
return 0
}

