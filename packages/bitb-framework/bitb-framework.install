#!/bin/bash

pre_install() {
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  return 1
else
  echo "Preparing enviroment ..."
  if [[ -d ${HOME}/.local/share/bitb ]]
  then
    rm -rf ${HOME}/.local/share/bitb
  else
    mkdir -p ${HOME}/.local/share 2>/dev/null
  fi
fi
}

post_install() {
bash ${PREFIX}/bin/bitb-installer
echo "[*] bitb installation finished."
echo "[*] Run \'bitb\' to execute it."
}

pre_remove() {
if [[ -d ${HOME}/.local/share/bitb ]]; then
  rm -rf ${HOME}/.local/share/bitb
fi
}

post_remove() {
echo "Done. Package 'bitb' removed."
}

