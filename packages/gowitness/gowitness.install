#!/bin/bash

post_install() {
set -e

VERSION="3.2.2"
BUILD_DIR="$TMPDIR/gowitness-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/sensepost/gowitness/archive/refs/tags/3.2.2.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gowitness .
install -Dm755 gowitness "$PREFIX/bin/gowitness"

cd / && rm -rf "$BUILD_DIR"

echo "gowitness installed. Run 'gowitness'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/gowitness"
echo "gowitness removed."
return 0
}

