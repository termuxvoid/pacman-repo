#!/bin/bash

post_install() {
set -e

VERSION="1.2.1"
BUILD_DIR="$TMPDIR/subzy-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/PentestPad/subzy/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o subzy .
install -Dm755 subzy "$PREFIX/bin/subzy"

cd / && rm -rf "$BUILD_DIR"

echo "subzy installed. Run 'subzy'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/subzy"
echo "subzy removed."
return 0
}

