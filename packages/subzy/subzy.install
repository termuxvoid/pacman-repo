#!/bin/bash

post_install() {

LAUNCHER="$PREFIX/bin/subzy"
SUBZY_BIN="$HOME/go/bin/subzy"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Installing subzy...${NC}"
go install -v github.com/PentestPad/subzy@latest || {
    echo -e "${RED}Error: Failed to install subzy. Ensure Go is installed and internet is available.${NC}"
    return 1
}

echo -e "${GREEN}Creating launcher at $LAUNCHER...${NC}"
cat > "$LAUNCHER" <<- EOF
$SUBZY_BIN "\$@"
EOF

chmod +x "$LAUNCHER" || {
    echo -e "${RED}Error: Failed to set executable permissions for $LAUNCHER.${NC}"
    return 1
}

if [ -x "$SUBZY_BIN" ]; then
    echo -e "${GREEN}subzy installed successfully. Run 'subzy -h' to verify.${NC}"
else
    echo -e "${RED}Error: subzy binary not found at $SUBZY_BIN.${NC}"
    return 1
fi
}

post_remove() {

LAUNCHER="$PREFIX/bin/subzy"
SUBZY_BIN="$HOME/go/bin/subzy"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling subzy...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$SUBZY_BIN" ]; then
    rm -f "$SUBZY_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $SUBZY_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

