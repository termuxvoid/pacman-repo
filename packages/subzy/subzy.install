#!/bin/bash

post_install() {
set -e

VERSION="1.2.1"
BUILD_DIR="$TMPDIR/subzy-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/PentestPad/subzy/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o subzy .
install -Dm755 subzy "$PREFIX/bin/subzy"

cd / && rm -rf "$BUILD_DIR"

echo "subzy installed. Run 'subzy'"
return 0
}

post_remove() {

LAUNCHER="$PREFIX/bin/subzy"
SUBZY_BIN="$HOME/go/bin/subzy"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling subzy...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$SUBZY_BIN" ]; then
    rm -f "$SUBZY_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $SUBZY_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

