#!/bin/bash

post_install() {
set -e

VERSION="0.5.4"
BUILD_DIR="$TMPDIR/nosqli-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/Charlie-belmer/nosqli/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="ab519f979d345d27ed9c0bd33994eb5cf88844784f9f1673af218a67675a3b92"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    return 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o nosqli .
install -Dm755 nosqli "$PREFIX/bin/nosqli"

cd / && rm -rf "$BUILD_DIR"

echo "nosqli installed. Run 'nosqli'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/nosqli"
echo "nosqli removed."
return 0
}

