# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/emailcrawl)

pkgname="emailcrawl"
pkgver=1.0
pkgrel=1
pkgdesc='Professional-grade OSINT email extraction tool'
arch=('any')
url="https://github.com/techenthusiast167/EMAIL-CRAWL"
depends=('python' 'python-lxml')
install="emailcrawl.install"
options=('!strip' '!debug' '!emptydirs')
source=(emailcrawl-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/emailcrawl-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
