# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/enctool)

pkgname="enctool"
pkgver=1.0
pkgrel=1
pkgdesc='encrypt or decrypt bash file and encrypt python in Marshal format'
arch=('any')
depends=('python' 'nodejs')
install="enctool.install"
options=('!strip' '!debug' '!emptydirs')
source=(enctool-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/enctool-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
