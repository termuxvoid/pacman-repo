#!/bin/bash

post_install() {
set -e
go install -trimpath -ldflags "-w -s" github.com/projectdiscovery/naabu/v2/cmd/naabu@v2.6.1
if [ ! -f "$PREFIX/bin/naabu" ] && [ -f "$HOME/go/bin/naabu" ]; then
    ln -sf "$HOME/go/bin/naabu" "$PREFIX/bin/naabu"
fi
return 0
}

post_remove() {
rm -f "$HOME/go/bin/naabu" "$PREFIX/bin/naabu"
return 0
}

