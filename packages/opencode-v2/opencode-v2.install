#!/bin/bash

pre_install() {

ARCH=$(uname -m)
case "$ARCH" in
    aarch64|x86_64)
        return 0
        ;;
    *)
        echo "Error: opencode-v2 supports only aarch64 and x86_64." >&2
        echo "Your architecture: $ARCH" >&2
        return 1
        ;;
esac
}

post_install() {
set -euo pipefail

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="2.2.0"
ARCH=$(uname -m)
case "$ARCH" in
    aarch64)
        NPM_ARCH="arm64"
        SHA256="6a40643c0dca3aff9d37c87c26c0ee003c46abb810e1c6ddde094ffbf7460b8b"
        LD_SO="ld-linux-aarch64.so.1"
        ;;
    x86_64)
        NPM_ARCH="x64"
        SHA256="fe3046b86872e624f62268058f4801a1f1efffc193103a9988238c891b8ca028"
        LD_SO="ld-linux-x86-64.so.2"
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        return 1
        ;;
esac
TARFILE="cli-linux-${NPM_ARCH}-${VERSION}.tgz"
DOWNLOAD_URL="https://registry.npmjs.org/@opencode/cli-linux-${NPM_ARCH}/-/${TARFILE}"
SHARE_DIR="$PREFIX/share/opencode-v2"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/$LD_SO"
LIB_PATH="$PREFIX/glibc/lib"
TMPDIR=${TMPDIR:-$PREFIX/tmp}

die() {
    echo "opencode-v2: $*" >&2
    return 1
}

[ -x "$LOADER" ] ||
    die "glibc loader not found; install glibc-repo and glibc"

STAGE=$(mktemp -d "$TMPDIR/opencode-v2.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT

echo "Downloading OpenCode 2 ${VERSION}..."
curl -fL --retry 3 --max-time 600 -o "$STAGE/$TARFILE" "$DOWNLOAD_URL"
printf '%s  %s\n' "$SHA256" "$STAGE/$TARFILE" | sha256sum -c - >/dev/null ||
    die "checksum mismatch"
tar -xzf "$STAGE/$TARFILE" -C "$STAGE"
[ -f "$STAGE/package/bin/opencode" ] ||
    die "OpenCode 2 binary not found in archive"

rm -rf "$SHARE_DIR"
mkdir -p "$SHARE_DIR" "$BIN_DIR"
patchelf --set-interpreter "$LOADER" "$STAGE/package/bin/opencode"
mv "$STAGE/package/bin/opencode" "$SHARE_DIR/opencode.real"
chmod 755 "$SHARE_DIR/opencode.real"

cat > "$STAGE/opencode-v2.c" <<'C_EOF'
#include <stdlib.h>
#include <unistd.h>
#include <stdio.h>

int main(int argc, char** argv) {
    unsetenv("LD_PRELOAD");

    setenv("LD_LIBRARY_PATH", "/data/data/com.termux/files/usr/glibc/lib", 1);
    setenv("GODEBUG", "netdns=cgo", 1);
    setenv("SSL_CERT_FILE", "/data/data/com.termux/files/usr/etc/tls/cert.pem", 1);

    char real_bin[] = "/data/data/com.termux/files/usr/share/opencode-v2/opencode.real";

    char** new_argv = malloc((argc + 1) * sizeof(char*));
    if (!new_argv) {
        return 1;
    }

    new_argv[0] = real_bin;
    for (int i = 1; i < argc; i++) {
        new_argv[i] = argv[i];
    }
    new_argv[argc] = NULL;

    execv(real_bin, new_argv);
    perror("execv");
    free(new_argv);
    return 1;
}
C_EOF

clang -O2 -o "$BIN_DIR/opencode-v2" "$STAGE/opencode-v2.c"
chmod 755 "$BIN_DIR/opencode-v2"

if timeout 60 "$BIN_DIR/opencode-v2" --version >/dev/null; then
    echo "OpenCode 2 ${VERSION} installed successfully."
else
    die "OpenCode 2 failed to start"
fi
echo "Run 'opencode-v2' to start."
}

post_upgrade() {
    post_install "$@"
}

post_remove() {
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}

rm -f "$PREFIX/bin/opencode-v2"
rm -rf "$PREFIX/share/opencode-v2"

return 0
}

