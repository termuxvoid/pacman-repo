#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing sploitscan 0.14.3...${NC}"

echo -e "${YELLOW}Installing sploitscan via pip...${NC}"
pip install sploitscan==0.14.3 || {
    echo -e "${RED}Error: Failed to install sploitscan.${NC}"
    return 1
}

echo -e "${GREEN}sploitscan installed successfully!${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling sploitscan...${NC}"

pip uninstall -y sploitscan 2>/dev/null || {
    echo -e "${YELLOW}sploitscan not found or already uninstalled.${NC}"
}

echo -e "${GREEN}sploitscan completely removed${NC}"
return 0
}

