# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/mtcr-apply)

pkgname="mtcr-apply"
pkgver=1.1.0
pkgrel=1
pkgdesc='MTCR Patch Application Tool for Android APKs'
arch=('any')
url="https://telegram.me/NullRE_Channel"
depends=('openjdk-21')
options=('!strip' '!debug' '!emptydirs')
source=(mtcr-apply-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/mtcr-apply-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
