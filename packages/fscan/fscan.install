#!/bin/bash

post_install() {
set -e

REPO_DIR="$TMPDIR/fscan"
git clone --depth 1 --branch v2.2.0 https://github.com/shadow1ng/fscan.git "$REPO_DIR"
cd "$REPO_DIR"
go build -trimpath -ldflags "-w -s" -o fscan .
install -Dm700 -t "$PREFIX/bin" fscan
rm -rf "$REPO_DIR"

return 0
}

post_remove() {
rm -f "$PREFIX/bin/fscan"
return 0
}

