# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/jsql)

pkgname="jsql"
pkgver=0.144
pkgrel=1
pkgdesc='Lightweight database information finder from a server'
arch=('any')
url="https://github.com/ron190/jsql-injection"
depends=('curl' 'openjdk-21')
install="jsql.install"
options=('!strip' '!debug' '!emptydirs')
source=(jsql-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/jsql-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
