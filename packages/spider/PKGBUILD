# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/spider)

pkgname="spider"
pkgver=2.0
pkgrel=1
pkgdesc='telegram autoreport script'
arch=('any')
depends=('python' 'python-pip')
install="spider.install"
options=('!strip' '!debug' '!emptydirs')
source=(spider-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/spider-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
