# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/webserver)

pkgname="webserver"
pkgver=1.2
pkgrel=1
pkgdesc='a simple webserver for termux'
arch=('any')
depends=('php' 'figlet' 'openssh')
options=('!strip' '!debug' '!emptydirs')
source=(webserver-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/webserver-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
