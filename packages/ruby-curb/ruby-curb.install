#!/bin/bash

post_install() {
set -e

# Derive the real site_ruby dir (never hardcode 3.x) so files land on the
# ruby's $LOAD_PATH regardless of the installed ruby version.
SITE_RUBY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitelibdir"]')"

cd "$TMPDIR"
gem fetch curb -v 1.3.5
GEM_FILE=$(ls curb-*.gem | head -n1)
gem unpack "$GEM_FILE"
DIR_NAME=$(ls -d curb-*/ | head -n1)
cd "${DIR_NAME}ext"
sed -i 's/unless PARALLEL_CONSTANT_CHECKS/return; unless PARALLEL_CONSTANT_CHECKS/' extconf.rb
ruby extconf.rb --with-curl-lib="$PREFIX/lib" --with-curl-include="$PREFIX/include"
make
make install

cd ..
mkdir -p "$SITE_RUBY"
cp -r lib/* "$SITE_RUBY/"

cd "$TMPDIR"
rm -rf "$GEM_FILE" "$DIR_NAME"

echo "Verifying installation..."
ruby -rcurb -e "puts Curl::VERSION" || {
    echo "Curb installation failed!" >&2
    return 1
}

echo "Curb installed successfully."
return 0
}

post_remove() {
set -e

SITE_RUBY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitelibdir"]')"
SITE_ARCH="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitearchdir"]')"

rm -f "$SITE_RUBY/curb.rb"
rm -f "$SITE_RUBY/curl.rb"
rm -rf "$SITE_RUBY/curl"
rm -f "$SITE_ARCH/curb_core.so"

# Clean up leftovers from the old hardcoded site_ruby/3.4.0 installs
rm -rf "$PREFIX/lib/ruby/site_ruby/3.4.0"
return 0
}