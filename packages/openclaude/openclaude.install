#!/bin/bash

post_install() {

set -e

echo "Installing OpenClaude..."
npm install -g @gitlawb/openclaude@0.29.1 || exit 1
echo "OpenClaude installed successfully."
return 0
}

post_remove() {

npm uninstall -g @gitlawb/openclaude 2>/dev/null && echo "OpenClaude removed." || echo "OpenClaude not found."
return 0
}

