# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/openclaude)

pkgname="openclaude"
pkgver=0.31.0
pkgrel=0
pkgdesc='Open‑source coding‑agent CLI for cloud and local LLMs'
arch=('any')
url="https://github.com/Gitlawb/openclaude"
depends=('npm' 'ripgrep' 'proot')
install="openclaude.install"
options=('!strip' '!debug' '!emptydirs')
source=(openclaude-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/openclaude-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
