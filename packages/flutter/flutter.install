#!/bin/bash

pre_install() {
set -e

echo "[*] Checking device architecture..."
ARCH=$(uname -m)

if [ "$ARCH" != "aarch64" ]; then
    echo "[!] ERROR: This package requires aarch64 architecture"
    echo "[!] Your device architecture: $ARCH"
    echo "[!] Installation cannot continue"
    return 1
fi

echo "[√] Architecture check passed: aarch64"
return 0
}

post_install() {
set -e

FLUTTER_DIR="$PREFIX/opt/flutter"
DOWNLOAD_URL="https://github.com/termuxvoid/flutter-termux/releases/download/3.47.7/flutter_3.47.7_aarch64.tar.gz"
TMP_ARCHIVE="$TMPDIR/flutter.tar.gz"

echo "[*] Setting up Flutter..."
[ -d "$FLUTTER_DIR" ] && { echo "[*] Removing existing installation..."; rm -rf "$FLUTTER_DIR"; }

echo "[*] Creating installation directory..."
mkdir -p "$PREFIX/opt"

echo "[*] Downloading Flutter SDK..."
axel -n 10 -o "$TMP_ARCHIVE" "$DOWNLOAD_URL" || { echo "[!] Download failed"; exit 1; }

echo "[*] Extracting Flutter SDK..."
SHA256="0fa28eccd823c216ddd2641fb067efd6af169e77145397d8a02e72930619ea71"
if ! printf '%s  %s\n' "$SHA256" "$TMP_ARCHIVE" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMP_ARCHIVE" >&2
    rm -f "$TMP_ARCHIVE"
    return 1
fi
tar -xzf "$TMP_ARCHIVE" -C "$PREFIX/opt" || { echo "[!] Extraction failed"; exit 1; }

echo "[*] Creating launcher..."
cat > "$PREFIX/bin/flutter" << EOF
exec "$FLUTTER_DIR/bin/flutter" "\$@"
EOF
chmod +x "$PREFIX/bin/flutter"

echo "[*] Setting permissions..."
chmod -R 755 "$FLUTTER_DIR/bin"

echo -e "\n[√] Flutter installed successfully!"
echo "Run: flutter --version"
echo "Run: flutter doctor"
return 0
}

post_remove() {
set -e

echo "[*] Removing Flutter SDK..."
rm -rf "$PREFIX/opt/flutter"

echo "[*] Removing launcher..."
rm -f "$PREFIX/bin/flutter"


echo "[√] Flutter completely removed"
return 0
}

