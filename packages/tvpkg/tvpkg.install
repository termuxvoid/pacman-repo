#!/bin/bash

post_install() {
set -e

VER="0.2.0"
TAG="v${VER}"
BASE="https://github.com/termuxvoid/tvpkg/releases/download/${TAG}"
TMP_DIR="$TMPDIR/tvpkg-install"
BIN_DIR="$PREFIX/bin"

case "$(uname -m)" in
    aarch64) ARCH=aarch64 ;;
    armv8l|armv7l|armv6l|arm) ARCH=arm ;;
    x86_64) ARCH=x86_64 ;;
    i686|i386) ARCH=i686 ;;
    *) echo "tvpkg: unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"
cd "$TMP_DIR"

TGZ="tvpkg-${TAG}-${ARCH}.tar.gz"
curl -fsSL -o "$TGZ" "$BASE/$TGZ"
curl -fsSL -o SHA256SUMS "$BASE/SHA256SUMS"
grep -F "  $TGZ" SHA256SUMS > tvpkg.sha
sha256sum -c tvpkg.sha

tar -xzf "$TGZ"
install -Dm755 tvpkg "$BIN_DIR/tvpkg"
ln -sf tvpkg "$BIN_DIR/tvp"

cd / && rm -rf "$TMP_DIR"

echo "tvpkg installed: '$BIN_DIR/tvpkg' (alias 'tvp'). Run 'tvpkg' to start."
return 0
}

post_remove() {
set -e

# Remove the installed binary and its alias symlink on uninstall.
# Skip during upgrades (postinst re-installs them). Under pacman's
# post_remove() there is no "$1", so the check falls through to removal.
if [ "${1:-}" != "upgrade" ]; then
    rm -f "$PREFIX/bin/tvpkg" "$PREFIX/bin/tvp"
fi

return 0
}

