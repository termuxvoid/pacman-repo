#!/bin/bash

post_install() {
    set -e

    # strip pacman pkgrel suffix: npm needs the bare upstream version
    UPVER="${1%%-*}"

    npm install -g "@mmmbuto/codex-cli-termux@${UPVER}"
    echo "codex-cli ${UPVER} installed. Run 'codex' to start."
}

post_remove() {
    npm uninstall -g @mmmbuto/codex-cli-termux 2>/dev/null || true
    echo "codex-cli removed."
}
