#!/bin/bash

pre_install() {
rhawkDir="$PREFIX/var/rhawk"

if [[ $(id -u) -eq 0 ]]
then
	echo -en "\e[31m(_➤)\e[0m You need to be a common user"
  return 1
else
	echo "Preparing enviroment ..."
	if [[ -d $rhawkDir ]]
	then
		rm -rf $rhawkDir
	fi
fi
}

post_install() {
rhawkDir="$PREFIX/var/rhawk"
git clone --quiet https://github.com/Tuhinshubhra/RED_HAWK.git $rhawkDir

[[ -d $rhawkDir ]] && {
  chmod 751 -R $rhawkDir
} || {
 echo -en "\e[31mE:\e[0m rhawk directory missing ... \e[33mAborting.\e[0m\n"
}
printf "\n[+] RED_HAWK installed successfully"
printf "\n[+] Execute it by typing rhawk\n"
return 0
}

pre_remove() {
rhawkDir="$PREFIX/var/rhawk"
if [[ -d "$rhawkDir" ]]; then
  rm -rf $rhawkDir
fi
}

post_remove() {
echo "[*] RED_HAWK removed.."
return 0
}

