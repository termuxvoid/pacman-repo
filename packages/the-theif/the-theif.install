#!/bin/bash

post_install() {
pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary rich
mkdir -p ~/the-theif
printf "\n\nthe-theif is installed...\nReport issus at telegram.me/nullxvoid"
}

post_remove() {
rm -rf ~/the-theif/
rm -rf ~/.config/the-theif.conf
echo "unistalled finish.."
}

