# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/termux-penv)

pkgname="termux-penv"
pkgver=2.0.1
pkgrel=1
pkgdesc='Termux Penv - Simplify Chroot Environments in Termux'
arch=('any')
url="https://github.com/Anon4You/termux-penv.git"
depends=('wget' 'proot' 'figlet')
install="termux-penv.install"
options=('!strip' '!debug' '!emptydirs')
source=(termux-penv-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/termux-penv-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
