# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/termux-desktop-wallpapers)

pkgname="termux-desktop-wallpapers"
pkgver=1.0
pkgrel=1
pkgdesc='Wallpapers for termux-desktop'
arch=('any')
url="https://alienkrishn.infy.uk"
depends=('termux-tools' 'termux-desktop')
options=('!strip' '!debug' '!emptydirs')
source=(termux-desktop-wallpapers-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/termux-desktop-wallpapers-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
