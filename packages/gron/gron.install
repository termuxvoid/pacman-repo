#!/bin/bash

post_install() {
set -e

VERSION="0.7.1"
BUILD_DIR="$TMPDIR/gron-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/gron/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o gron .
install -Dm755 gron "$PREFIX/bin/gron"

cd / && rm -rf "$BUILD_DIR"

echo "gron installed. Run 'gron'"
return 0
}

post_remove() {

rm -f "$HOME/go/bin/gron" "$PREFIX/bin/gron"

return 0
}

