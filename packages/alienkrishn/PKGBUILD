# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/alienkrishn)

pkgname="alienkrishn"
pkgver=2.0.7
pkgrel=1
pkgdesc='TermuxVoid package manager and system helper'
arch=('any')
url="https://termuxvoid.github.io/"
depends=('curl' 'termux-tools')
options=('!strip' '!debug' '!emptydirs')
source=(alienkrishn-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/alienkrishn-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
