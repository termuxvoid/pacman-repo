# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/cloudflare-gui)

pkgname="cloudflare-gui"
pkgver=1.0
pkgrel=1
pkgdesc='Stylish GUI for Cloudflare Tunnels'
arch=('any')
url="https://github.com/Keyaru-code/Cloudflare-GUI"
depends=('cloudflared' 'python' 'python-pip' 'python-tkinter')
install="cloudflare-gui.install"
options=('!strip' '!debug' '!emptydirs')
source=(cloudflare-gui-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/cloudflare-gui-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
