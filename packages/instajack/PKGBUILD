# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/instajack)

pkgname="instajack"
pkgver=1.0
pkgrel=1
pkgdesc='Instagram old account jacker'
arch=('any')
depends=('python' 'python-pip')
install="instajack.install"
options=('!strip' '!debug' '!emptydirs')
source=(instajack-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/instajack-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
