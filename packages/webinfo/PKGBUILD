# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/webinfo)

pkgname="webinfo"
pkgver=3.0
pkgrel=1
pkgdesc='Website information gathering '
arch=('any')
url="https://github.com/Anon4You/webinfo/"
depends=('curl' 'openssl-tool' 'dnsutils' 'nmap' 'whois' 'traceroute')
options=('!strip' '!debug' '!emptydirs')
source=(webinfo-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/webinfo-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
