#!/bin/bash

post_install() {

LAUNCHER="$PREFIX/bin/mantra"
MANTRA_BIN="$HOME/go/bin/mantra"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Installing mantra...${NC}"
go install -v github.com/Brosck/mantra@latest || {
    echo -e "${RED}Error: Failed to install mantra. Ensure Go is installed and internet is available.${NC}"
    return 1
}

echo -e "${GREEN}Creating launcher at $LAUNCHER...${NC}"
cat > "$LAUNCHER" <<- EOF
$MANTRA_BIN "\$@"
EOF

chmod +x "$LAUNCHER" || {
    echo -e "${RED}Error: Failed to set executable permissions for $LAUNCHER.${NC}"
    return 1
}

if [ -x "$MANTRA_BIN" ]; then
    echo -e "${GREEN}mantra installed successfully. Run 'mantra -h' to verify.${NC}"
else
    echo -e "${RED}Error: mantra binary not found at $MANTRA_BIN.${NC}"
    return 1
fi
}

post_remove() {

LAUNCHER="$PREFIX/bin/mantra"
MANTRA_BIN="$HOME/go/bin/mantra"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling mantra...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$MANTRA_BIN" ]; then
    rm -f "$MANTRA_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $MANTRA_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

