#!/bin/bash

post_install() {
set -e

VERSION="3.1"
BUILD_DIR="$TMPDIR/mantra-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/Brosck/mantra/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o mantra .
install -Dm755 mantra "$PREFIX/bin/mantra"

cd / && rm -rf "$BUILD_DIR"

echo "mantra installed. Run 'mantra'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/mantra"
echo "mantra removed."
return 0
}

