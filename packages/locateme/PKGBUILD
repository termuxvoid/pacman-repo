# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/locateme)

pkgname="locateme"
pkgver=1.2
pkgrel=1
pkgdesc='Live location tracker using google maps'
arch=('any')
depends=('php' 'jq' 'openssh' 'figlet')
options=('!strip' '!debug' '!emptydirs')
source=(locateme-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/locateme-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
