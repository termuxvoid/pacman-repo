# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/blackbox-framework)

pkgname="blackbox-framework"
pkgver=2.0
pkgrel=1
pkgdesc='A Python-based network analysis and exploitation toolkit'
arch=('any')
url="https://github.com/jothatron/blackbox"
depends=('python2')
install="blackbox-framework.install"
options=('!strip' '!debug' '!emptydirs')
source=(blackbox-framework-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/blackbox-framework-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
