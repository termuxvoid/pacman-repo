#!/bin/bash

post_install() {
set -e

    # ethon must link system libs, never bundled C sources
    export NOKOGIRI_USE_SYSTEM_LIBRARIES=1

    VERSION="0.18.0"

    # Ruby 4.x no longer auto-loads rubygems, so a gem-installed lib is
    # un-require-able via plain `ruby -rethon`. Ship ethon into site_ruby and
    # make it load rubygems itself (mirrors the ruby-nokogiri fix).
    gem install ethon -v "${VERSION}" -- --use-system-libraries

    GEM_DIR="$(find "$PREFIX/lib/ruby/gems" -maxdepth 4 -type d -name "ethon-${VERSION}" | head -n1)"

    # Apply the patch to libc.rb
    file="$GEM_DIR/lib/ethon/libc.rb"
    if [ -n "$GEM_DIR" ] && [ -f "$file" ]; then
        cat > "$file" << 'EOF'
# frozen_string_literal: true
module Ethon

  # FFI Wrapper module for Libc.
  #
  # @api private
  module Libc
    extend FFI::Library
    ffi_lib 'c'

    # :nodoc:
    def self.windows?
      Gem.win_platform?
    end

    unless windows?
      def self.getdtablesize
        1024
      end

      attach_function :free, [:pointer], :void
    end
  end
end
EOF
        echo "Patched $file"
    else
        echo "ethon/libc.rb not found"
    fi

    SITE_RUBY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitelibdir"]')"
    mkdir -p "$SITE_RUBY"
    cp -r "$GEM_DIR/lib/ethon" "$SITE_RUBY/"
    cp "$GEM_DIR/lib/ethon.rb" "$SITE_RUBY/"

    for f in "$SITE_RUBY/ethon.rb" "$SITE_RUBY/ethon/libc.rb"; do
        [ -f "$f" ] || continue
        grep -q 'require "rubygems" unless defined?(Gem)' "$f" ||
            sed -i '1i require "rubygems" unless defined?(Gem)' "$f"
    done

    echo "Verifying installation..."
    ruby -rethon -e "puts Ethon::VERSION" || {
        echo "Ethon installation failed!" >&2
        return 1
    }

    echo "ruby-ethon installed successfully."
    return 0
}

post_remove() {
set -e

gem uninstall ethon -v 0.18.0 -x --force 2>/dev/null || true

SITE_RUBY="$(ruby -rrbconfig -e 'print RbConfig::CONFIG["sitelibdir"]')"
rm -rf "$SITE_RUBY/ethon"
rm -f "$SITE_RUBY/ethon.rb"

echo "ruby-ethon completely removed."
return 0
}