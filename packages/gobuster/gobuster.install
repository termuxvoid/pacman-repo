#!/bin/bash

post_install() {

LAUNCHER="$PREFIX/bin/gobuster"
GOBUSTER_BIN="$HOME/go/bin/gobuster"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Installing gobuster...${NC}"
go install -v github.com/OJ/gobuster/v3@latest || {
    echo -e "${RED}Error: Failed to install gobuster. Ensure Go is installed and internet is available.${NC}"
    return 1
}

echo -e "${GREEN}Creating launcher at $LAUNCHER...${NC}"
cat > "$LAUNCHER" <<- EOF
$GOBUSTER_BIN "\$@"
EOF

chmod +x "$LAUNCHER" || {
    echo -e "${RED}Error: Failed to set executable permissions for $LAUNCHER.${NC}"
    return 1
}

if [ -x "$GOBUSTER_BIN" ]; then
    echo -e "${GREEN}gobuster installed successfully. Run 'gobuster -h' to verify.${NC}"
else
    echo -e "${RED}Error: gobuster binary not found at $GOBUSTER_BIN.${NC}"
    return 1
fi
}

post_remove() {

LAUNCHER="$PREFIX/bin/gobuster"
GOBUSTER_BIN="$HOME/go/bin/gobuster"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling gobuster...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$GOBUSTER_BIN" ]; then
    rm -f "$GOBUSTER_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $GOBUSTER_BIN)${NC}"
fi

# Removal hooks run without a TTY, so an interactive `read` would hang.
# Default to NOT cleaning the user's wordlists (non-destructive); opt in
# with GOBUSTER_CLEAN=1 for scripted removals.
choice="${GOBUSTER_CLEAN:-N}"
[[ "$choice" =~ [yY] ]] && {
    rm -rf "$HOME/gobuster-wordlists" 2>/dev/null && \
    echo -e "${GREEN}✓ Wordlists removed${NC}" || \
    echo -e "${RED}✗ No wordlists found${NC}"
}

echo -e "${GREEN}Uninstallation complete${NC}"
}

