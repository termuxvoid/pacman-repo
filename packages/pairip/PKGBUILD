# Ported from TermuxVoid APT repo (packages/pairip)

pkgname="pairip"
pkgver=1.3.10
pkgrel=1
pkgdesc='PairIP Protection Removal Tool'
arch=('any')
url="https://telegram.me/NullRE_Channel"
depends=('openjdk-21')
options=('!strip' '!debug' '!emptydirs')
source=(pairip-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/pairip-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
