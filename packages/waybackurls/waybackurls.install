#!/bin/bash

post_install() {
set -e

VERSION="0.1.0"
BUILD_DIR="$TMPDIR/waybackurls-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/waybackurls/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o waybackurls .
install -Dm755 waybackurls "$PREFIX/bin/waybackurls"

cd / && rm -rf "$BUILD_DIR"

echo "waybackurls installed. Run 'waybackurls'"
return 0
}

post_remove() {

LAUNCHER="$PREFIX/bin/waybackurls"
WAYBACKURLS_BIN="$HOME/go/bin/waybackurls"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling waybackurls...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$WAYBACKURLS_BIN" ]; then
    rm -f "$WAYBACKURLS_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $WAYBACKURLS_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

