#!/bin/bash

post_install() {

LAUNCHER="$PREFIX/bin/waybackurls"
WAYBACKURLS_BIN="$HOME/go/bin/waybackurls"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Installing waybackurls...${NC}"
go install -v github.com/tomnomnom/waybackurls@latest || {
    echo -e "${RED}Error: Failed to install waybackurls. Ensure Go is installed and internet is available.${NC}"
    return 1
}

echo -e "${GREEN}Creating launcher at $LAUNCHER...${NC}"
cat > "$LAUNCHER" <<- EOF
$WAYBACKURLS_BIN "\$@"
EOF

chmod +x "$LAUNCHER" || {
    echo -e "${RED}Error: Failed to set executable permissions for $LAUNCHER.${NC}"
    return 1
}

if [ -x "$WAYBACKURLS_BIN" ]; then
    echo -e "${GREEN}waybackurls installed successfully. Run 'waybackurls -h' to verify.${NC}"
else
    echo -e "${RED}Error: waybackurls binary not found at $WAYBACKURLS_BIN.${NC}"
    return 1
fi
}

post_remove() {

LAUNCHER="$PREFIX/bin/waybackurls"
WAYBACKURLS_BIN="$HOME/go/bin/waybackurls"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling waybackurls...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$WAYBACKURLS_BIN" ]; then
    rm -f "$WAYBACKURLS_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $WAYBACKURLS_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

