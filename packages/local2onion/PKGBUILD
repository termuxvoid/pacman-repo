# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/local2onion)

pkgname="local2onion"
pkgver=1.0
pkgrel=1
pkgdesc='Expose your localhost on the DARKWEB using termux'
arch=('any')
depends=('tor' 'php' 'curl' 'pv')
options=('!strip' '!debug' '!emptydirs')
source=(local2onion-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/local2onion-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
