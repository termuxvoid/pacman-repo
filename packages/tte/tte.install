#!/bin/bash

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Installing tte 0.15.0...${NC}"

echo -e "${YELLOW}Installing terminaltexteffects via pip...${NC}"
pip install terminaltexteffects==0.15.0 || {
    echo -e "${RED}Error: Failed to install terminaltexteffects.${NC}"
    return 1
}

echo -e "${GREEN}tte installed successfully!${NC}"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling tte...${NC}"

pip uninstall -y terminaltexteffects 2>/dev/null || {
    echo -e "${YELLOW}terminaltexteffects not found or already uninstalled.${NC}"
}

echo -e "${GREEN}tte completely removed${NC}"
return 0
}

