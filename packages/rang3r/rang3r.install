#!/bin/bash

post_install() {
set -e

REPO="https://github.com/floriankunushevci/rang3r.git"
INSTALL_DIR="$PREFIX/share/rang3r"
LAUNCHER="$PREFIX/bin/rang3r"

rm -rf "$INSTALL_DIR" 2>/dev/null || true

git clone --depth 1 "$REPO" "$INSTALL_DIR"

pip2 install termcolor

cat > "$LAUNCHER" << 'EOF'
cd "$PREFIX/share/rang3r"
exec python2 rang3r.py "$@"
EOF

chmod +x "$LAUNCHER"

echo "rang3r installed. Run 'rang3r'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/rang3r"
rm -rf "$PREFIX/share/rang3r"
echo "rang3r removed."
return 0
}

