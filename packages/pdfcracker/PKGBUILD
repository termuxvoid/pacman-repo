# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/pdfcracker)

pkgname="pdfcracker"
pkgver=1.0
pkgrel=0
pkgdesc='A powerful yet simple PDF password recovery tool designed for security professionals and ethical hackers.'
arch=('any')
url="https://github.com/Anon4You/PDFCracker"
depends=('qpdf')
options=('!strip')
source=(pdfcracker-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    tar -xzf "${srcdir}/pdfcracker-data.tar.gz" -C "${pkgdir}"
}
