# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/cctvip)

pkgname="cctvip"
pkgver=1.0.0
pkgrel=1
pkgdesc='A collection of open cctv camera ip'
arch=('any')
depends=('python' 'python-pip' 'figlet')
install="cctvip.install"
options=('!strip' '!debug' '!emptydirs')
source=(cctvip-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/cctvip-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
