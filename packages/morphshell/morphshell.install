#!/bin/bash

post_install() {
set -e

RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
RESET='\033[0m'

# Pacman install hooks run with stdin from /dev/null (no TTY), so an
# interactive `read` would silently consume nothing and the prompt would
# never be shown. Allow a custom name via the MORPHSHELL_NAME env var
# (handy for scripted installs) and fall back to "MorphShell".
NAME="${MORPHSHELL_NAME:-MorphShell}"

# Hooks must use $HOME explicitly. `~` depends on $HOME being set; in
# some libalpm contexts it is not, which would land configs in /.
: "${HOME:?HOME must be set}"

clear
echo -e "${CYAN}
   __  ___              __   ______       ____
  /  |/  /__  _______  / /  / __/ /  ___ / / /
 / /|_/ / _ \/ __/ _ \/ _ \_\ \/ _ \/ -_) / /
/_/  /_/\___/_/ / .__/_//_/___/_//_/\__/_/_/
               /_/
${RESET}"

echo -e "${GREEN}
A sleek Termux theme with a smart prompt,
syntax highlighting, and a dynamic animated
banner that changes every session.
${RESET}"
echo -e "${YELLOW}Using prompt name: ${NAME} (set MORPHSHELL_NAME to override)${RESET}"

[ -f "$PREFIX/etc/motd" ] && rm -f "$PREFIX/etc/motd"

TMPDIR="${TMPDIR:-/tmp}"
DIR="$TMPDIR/MorphShell"
rm -rf "$DIR"

echo -e "${CYAN}[*] Cloning MorphShell...${RESET}"
if ! git clone -q https://github.com/termuxvoid/MorphShell "$DIR"; then
    echo -e "${RED}[!] git clone failed. Are you online?${RESET}" >&2
    return 1
fi

ASSETS="$DIR/assets"
for f in config.fish font.ttf colors.properties starship.toml motd; do
    [ -r "$ASSETS/$f" ] || {
        echo -e "${RED}[!] upstream asset missing: $f${RESET}" >&2
        return 1
    }
done

if [ "$(basename "$SHELL")" != "fish" ]; then
    echo -e "${GREEN}[*] Switching shell to fish${RESET}"
    chsh -s fish
fi
chsh -s fish

CFG_FISH="$HOME/.config/fish"
TERMUX_DIR="$HOME/.termux"
mkdir -p "$CFG_FISH" "$HOME/.config" "$TERMUX_DIR"

# Copy each asset to its destination directory. The original
# `cp "$ASSETS/font.ttf" "$ASSETS/colors.properties" ~/.termux` form
# relied on cp's many-to-one-target behaviour; spell it out to make
# the destinations obvious and avoid surprises.
cp "$ASSETS/config.fish"      "$CFG_FISH/config.fish"
cp "$ASSETS/font.ttf"        "$TERMUX_DIR/font.ttf"
cp "$ASSETS/colors.properties" "$TERMUX_DIR/colors.properties"

sed "s/user-name/$NAME/g" "$ASSETS/starship.toml" > "$HOME/.config/starship.toml"
sed "s/user-name/$NAME/g" "$ASSETS/motd"          > "$HOME/.config/morphshell"

# Verify every promised file actually landed; bail loudly if not.
missing=0
for f in \
    "$CFG_FISH/config.fish" \
    "$TERMUX_DIR/font.ttf" \
    "$TERMUX_DIR/colors.properties" \
    "$HOME/.config/starship.toml" \
    "$HOME/.config/morphshell"; do
    [ -s "$f" ] || { echo -e "${RED}[!] missing or empty: $f${RESET}" >&2; missing=1; }
done
[ "$missing" = 0 ] || return 1

echo -e "${GREEN}[✓] MorphShell installed. Restart Termux.${RESET}"
return 0
}

post_remove() {
set -e

# Hooks may run with HOME unset in some libalpm contexts; guard it.
: "${HOME:?HOME must be set}"

GREEN='\033[1;32m'
CYAN='\033[1;36m'
RESET='\033[0m'

echo -e "${CYAN}[*] Removing MorphShell configs...${RESET}"

# Remove MorphShell configs (use $HOME, not ~)
rm -f "$HOME/.config/morphshell"
rm -f "$HOME/.config/fish/config.fish"
rm -f "$HOME/.config/starship.toml"
rm -f "$HOME/.termux/font.ttf" "$HOME/.termux/colors.properties"

# Switch shell back to bash
CURRENT_SHELL=$(basename "$SHELL")
if [ "$CURRENT_SHELL" != "bash" ]; then
    echo -e "${GREEN}[*] Switching shell back to bash...${RESET}"
    chsh -s bash
fi

echo -e "${GREEN}[✓] MorphShell configs removed. Shell set to bash.${RESET}"
echo -e "${CYAN}Restart Termux to apply changes.${RESET}"
}
