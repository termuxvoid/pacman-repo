#!/bin/bash

post_install() {
set -e

VERSION="3.3.0"
BUILD_DIR="$TMPDIR/dalfox-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

SHA256="9613d8266b7fa7348829590caed0af567ba7cd0137075add913d8037066dd9dd"
curl -L -o "dalfox-${VERSION}.tar.gz" \
  "https://github.com/hahwul/dalfox/archive/refs/tags/v${VERSION}.tar.gz"
if ! printf '%s  %s\n' "$SHA256" "dalfox-${VERSION}.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: dalfox-${VERSION}.tar.gz" >&2
    rm -f "dalfox-${VERSION}.tar.gz"
    return 1
fi

tar -xzf "dalfox-${VERSION}.tar.gz"
cd "dalfox-${VERSION}"

cargo build --release --locked

install -Dm755 target/release/dalfox "$PREFIX/bin/dalfox"

cd /
rm -rf "$BUILD_DIR"

return 0
}

post_remove() {
set -e

# Remove binary
rm -f "$PREFIX/bin/dalfox"

# Optional: remove any leftover build cache (safe to remove)
rm -rf "$TMPDIR/dalfox-build" 2>/dev/null || true

return 0
}

