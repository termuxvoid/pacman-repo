#!/bin/bash

post_install() {
set -e

VERSION="1.0.3"
BUILD_DIR="$TMPDIR/kerbrute-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/ropnop/kerbrute/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o kerbrute .
install -Dm755 kerbrute "$PREFIX/bin/kerbrute"

cd / && rm -rf "$BUILD_DIR"

echo "kerbrute installed. Run 'kerbrute'"
return 0
}

post_remove() {

LAUNCHER="$PREFIX/bin/kerbrute"
KERBRUTE_BIN="$HOME/go/bin/kerbrute"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling Kerbrute...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$KERBRUTE_BIN" ]; then
    rm -f "$KERBRUTE_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $KERBRUTE_BIN)${NC}"
fi

read -p "Clean wordlists directory? [y/N]: " choice
[[ "$choice" =~ [yY] ]] && {
    rm -rf "$HOME/kerbrute-wordlists" 2>/dev/null && \
    echo -e "${GREEN}✓ Wordlists removed${NC}" || \
    echo -e "${RED}✗ No wordlists found${NC}"
}

echo -e "${GREEN}Uninstallation complete${NC}"
}

