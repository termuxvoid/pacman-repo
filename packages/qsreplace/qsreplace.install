#!/bin/bash

post_install() {
set -e

VERSION="0.0.3"
BUILD_DIR="$TMPDIR/qsreplace-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/qsreplace/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="42aa588fa25ec1e0c6af7f750bb0e25987702a1dce180c42f86caa8aea1aea38"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    return 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o qsreplace .
install -Dm755 qsreplace "$PREFIX/bin/qsreplace"

cd / && rm -rf "$BUILD_DIR"

echo "qsreplace installed. Run 'qsreplace'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/qsreplace"
echo "qsreplace removed."
return 0
}

