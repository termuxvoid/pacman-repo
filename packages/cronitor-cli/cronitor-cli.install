#!/bin/bash

pre_install() {
ARCH=$(uname -m)
case $ARCH in
    aarch64)
        ARCH_TYPE="arm64"
        ;;
    arm*)
        ARCH_TYPE="arm"
        ;;
    x86_64)
        ARCH_TYPE="amd64"
        ;;
    *)
        echo -e "${RED}Error: Unsupported architecture: $ARCH${NC}"
        return 1
        ;;
esac
}

post_install() {

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

VERSION="33.4"

echo -e "${GREEN}Installing CronitorCLI $VERSION...${NC}"

ARCH=$(uname -m)
case $ARCH in
    aarch64)
        ARCH_TYPE="arm64"
        SHA256="29fb3a82f07b1d8a3b82ad1ddb66b326e26a85887dc903fb4b5233d06f5372ed"
        ;;
    arm*)
        ARCH_TYPE="arm"
        SHA256="2ab0513f2cc0f2aa4263658dcfa0c4b4b20d09de03331c52ebfdda732411eaa4"
        ;;
    x86_64)
        ARCH_TYPE="amd64"
        SHA256="3482a6a7eed8a4a97af0d732dd5a42799063b025600aaded2624c6a5b355fab7"
        ;;
    *)
        echo -e "${RED}Error: Unsupported architecture: $ARCH${NC}"
        return 1
        ;;
esac

echo -e "${YELLOW}Detected architecture: $ARCH ($ARCH_TYPE)${NC}"

DOWNLOAD_URL="https://github.com/cronitorio/cronitor-cli/releases/download/$VERSION/linux_${ARCH_TYPE}.tar.gz"

curl -L -o $TMPDIR/cronitor.tar.gz $DOWNLOAD_URL || {
    echo -e "${RED}Error: Failed to download CronitorCLI binary.${NC}"
    return 1
}

if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/cronitor.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/cronitor.tar.gz" >&2
    rm -f "$TMPDIR/cronitor.tar.gz"
    return 1
fi
tar xvf $TMPDIR/cronitor.tar.gz -C $PREFIX/bin || {
    echo -e "${RED}Error: Failed to extract CronitorCLI.${NC}"
    return 1
}

chmod +x $PREFIX/bin/cronitor

rm -f $TMPDIR/cronitor.tar.gz

echo -e "${GREEN}CronitorCLI installed successfully!${NC}"
echo -e "${YELLOW}Usage:${NC}"
echo "  cronitor --help"
echo "  cronitor ping [monitor-code]"
echo "  cronitor monitor list"
echo "  cronitor job run [command]"
return 0
}

post_remove() {

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling CronitorCLI...${NC}"

if [ -f "$PREFIX/bin/cronitor" ]; then
    rm -f $PREFIX/bin/cronitor
    echo -e "${GREEN}Removed cronitor binary${NC}"
fi

echo -e "${GREEN}CronitorCLI completely removed${NC}"
return 0
}

