# Maintainer: Alienkrishn [Anon4You]
# Ported from TermuxVoid APT repo (packages/shorturl)

pkgname="shorturl"
pkgver=1.0.0
pkgrel=1
pkgdesc='URL shortner for termux'
arch=('any')
depends=('toilet' 'curl')
options=('!strip' '!debug' '!emptydirs')
source=(shorturl-data.tar.gz)
sha256sums=('SKIP')

build() {
    return 0
}

package() {
    mkdir -p "${pkgdir}/data/data/com.termux/files"
    tar -xzf "${srcdir}/shorturl-data.tar.gz" -C "${pkgdir}/data/data/com.termux/files"
}
