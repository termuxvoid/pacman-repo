         'findutils' 'apr' 'apr-util' 'postgresql' 'openssl' 'readline'
         'libffi' 'libgmp' 'libpcap' 'libsqlite' 'libgrpc' 'libtool'
         'libxml2' 'libxslt' 'ncurses' 'make' 'ncurses-utils' 'git' 'wget'
         'unzip' 'zip' 'tar' 'termux-tools' 'termux-elf-cleaner'
         'pkg-config' 'ruby' 'ruby-nokogiri' 'apktool' 'apksigner')
install="metasploit-framework.install"
options=('!strip')

build() {
    return 0
}

package() {
    return 0
}
