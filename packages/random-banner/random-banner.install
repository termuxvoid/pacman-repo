#!/bin/bash

post_install() {
bin="$PREFIX/bin/random-banner"
rbqDir="$PREFIX/share/rbq"
git clone --quiet https://github.com/Alienkrishn/random_banners.git $rbqDir

cat > $bin <<- EOF
bdir="\$PREFIX/share/rbq"
cd \$bdir
bash rbq.sh
EOF
chmod 700 $bin
}

post_remove() {
rm -rf $PREFIX/share/rbq
rm -rf $PREFIX/bin/random-banner
}

