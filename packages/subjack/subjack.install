#!/bin/bash

post_install() {
set -e

VERSION="3.1.0"
BUILD_DIR="$TMPDIR/subjack-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/haccer/subjack/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o ./dist/subjack .
install -Dm755 ./dist/subjack "$PREFIX/bin/subjack"

cd / && rm -rf "$BUILD_DIR"

echo "subjack installed. Run 'subjack'"
return 0
}

post_remove() {

LAUNCHER="$PREFIX/bin/subjack"
SUBJACK_BIN="$HOME/go/bin/subjack"
GO_DIR="$HOME/go"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${GREEN}Uninstalling subjack...${NC}"

[ -d "$GO_DIR" ] && chmod 751 -R "$GO_DIR"

if [ -f "$LAUNCHER" ]; then
    rm -f "$LAUNCHER" && echo -e "${GREEN}✓ Removed launcher${NC}" || \
    echo -e "${RED}✗ Failed to remove launcher${NC}"
fi

if [ -f "$SUBJACK_BIN" ]; then
    rm -f "$SUBJACK_BIN" && echo -e "${GREEN}✓ Removed binary${NC}" || \
    echo -e "${RED}✗ Failed to remove binary (try: rm -f $SUBJACK_BIN)${NC}"
fi

echo -e "${GREEN}Uninstallation complete${NC}"
}

