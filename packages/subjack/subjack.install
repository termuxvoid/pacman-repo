#!/bin/bash

post_install() {
set -e

VERSION="3.1.0"
BUILD_DIR="$TMPDIR/subjack-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/haccer/subjack/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o ./dist/subjack .
install -Dm755 ./dist/subjack "$PREFIX/bin/subjack"

cd / && rm -rf "$BUILD_DIR"

echo "subjack installed. Run 'subjack'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/subjack"
echo "subjack removed."
return 0
}

