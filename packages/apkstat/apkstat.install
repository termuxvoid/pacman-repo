#!/bin/bash

post_install() {
set -e

URL="https://github.com/hexabin/APKStat/raw/master/apkstat.py"
BIN="$PREFIX/bin/apkstat"

curl -sL -o "$BIN" "$URL"

# Fix shebang to use Termux's Python
sed -i '1s|^#!.*|#!/data/data/com.termux/files/usr/bin/python|' "$BIN"

chmod +x "$BIN"

echo "apkstat installed. Run 'apkstat'"
return 0
}

post_remove() {
rm -f "$PREFIX/bin/apkstat"
echo "apkstat removed."
return 0
}

