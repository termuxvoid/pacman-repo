#!/bin/bash

post_install() {
set -e
go install -trimpath -ldflags "-w -s" github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.16.0
if [ ! -f "$PREFIX/bin/subfinder" ] && [ -f "$HOME/go/bin/subfinder" ]; then
    ln -sf "$HOME/go/bin/subfinder" "$PREFIX/bin/subfinder"
fi
return 0
}

post_remove() {
rm -f "$HOME/go/bin/subfinder" "$PREFIX/bin/subfinder"
return 0
}

